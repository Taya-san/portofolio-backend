# App
APP_NAME=portofolio-backend
APP_VERSION=0.0.0
# HTTP settings
HTTP_PORT=1234
HTTP_USE_PREFORK_MODE=false
# Logger
LOG_LEVEL=debug
# Metrics
METRICS_ENABLED=true
# Swagger
SWAGGER_ENABLED=true
# Tracing
TRACING_ENABLED=true
TRACING_PRETTIER=true
TRACING_SAMPLE_RATE=1.0
# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_TOKEN_EXPIRY=6h
# User
USER_PASSWORD=password
# Github
GITHUB_PROFILE_NAME=name
GITHUB_TOKEN=token
